# Copy to terraform.tfvars locally if desired. This file contains no credentials.
# The subscription ID is an Azure identifier, not an authentication secret.

subscription_id     = "35b0da56-c3e1-44f6-9634-d20cec115304"
resource_group_name = "internship_proxym"
acr_name            = "ghassenspringservices"
project_name        = "ghassen-dridi"
environment         = "aca"

# Network address ranges for the Azure Container Apps foundation.
vnet_address_space                       = ["10.80.0.0/16"]
aca_infrastructure_subnet_address_prefix = "10.80.0.0/23"
private_endpoints_subnet_address_prefix  = "10.80.2.0/24"

# Log Analytics data retention for the Container Apps foundation.
log_analytics_retention_in_days = 30

# Optional additional tags. Foundation defaults are defined in locals.tf.
tags = {}
